---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <!--
      Generated by `pnpm shots` (scripts/capture.mjs) from the rendered page, so
      the share image is literally the components. Relative for now: the site has
      no domain yet, and the spec wants an absolute URL — swap in the deployed
      origin once one exists, since not every crawler resolves a relative path.
    -->
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A task app screen built with radix-native-ui components, rendered live in the browser." />
    <meta name="twitter:image" content="/og.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!--
      Applied before first paint so the page never flashes the wrong scheme.
      The shell reads `:root[data-theme]`; the component demos below have their
      own `ThemeProvider`, which is deliberately independent of this attribute.
    -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          radix-native-ui
        </a>
        <nav class="nav-links" aria-label="Sections">
          <a href="#why">Why</a>
          <a href="#components">Components</a>
          <a href="#theming">Theming</a>
          <a href="#install">Install</a>
        </nav>
        <div class="nav-cta">
          <button class="ghost" id="theme-toggle" type="button" aria-label="Toggle color scheme">
            <span aria-hidden="true">◐</span> Theme
          </button>
          <a class="ghost" href="https://github.com/Copy-Labs/radix-native-ui" rel="noopener">GitHub</a>
          <a class="ghost" href="https://www.npmjs.com/package/radix-native-ui" rel="noopener">npm</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <strong>radix-native-ui</strong>
          <p class="faint" style="margin:4px 0 0">
            MIT licensed · inspired by Radix Themes, not affiliated with or endorsed by Radix.
          </p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/Copy-Labs/radix-native-ui">GitHub</a>
          <a href="https://www.npmjs.com/package/radix-native-ui">npm</a>
          <a href="https://github.com/Copy-Labs/radix-native-ui/blob/main/packages/radix-ui-themes-native/CHANGELOG.md">
            Changelog
          </a>
          <a href="https://github.com/Copy-Labs/radix-native-ui/blob/main/CODE_OF_CONDUCT.md">Code of conduct</a>
        </div>
        <p class="faint" style="margin:0">© {year} Copy Labs</p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      // Copy-to-clipboard for the install command.
      document.querySelectorAll('[data-copy]').forEach((node) => {
        node.addEventListener('click', async () => {
          const text = node.getAttribute('data-copy');
          if (!text) return;
          await navigator.clipboard.writeText(text);
          node.textContent = 'copied';
          setTimeout(() => (node.textContent = 'copy'), 1200);
        });
      });
    </script>
  </body>
</html>
