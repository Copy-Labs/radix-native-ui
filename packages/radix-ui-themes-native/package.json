{
  "name": "radix-native-ui",
  "version": "0.1.3",
  "description": "A React Native component library inspired by the Radix Themes design system",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "build:tsdown": "tsdown",
    "dev:tsdown": "tsdown --watch",
    "test": "jest",
    "clean": "rm -rf dist .turbo coverage",
    "yalc:publish": "yalc publish",
    "yalc:push": "yalc push",
    "yalc:watch": "yalc publish --watch",
    "dev:for-demo-app": "pnpm dev:tsdown && pnpm yalc:watch"
  },
  "peerDependencies": {
    "expo": ">=48",
    "expo-haptics": "^55.0.8",
    "react": ">=18",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.81.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "19.1.17",
    "jest": "^29.6.0",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-test-renderer": "^19.1.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Copy-Labs/radix-native-ui.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "radix",
    "themes",
    "ui-components",
    "accessibility"
  ],
  "bugs": {
    "url": "https://github.com/Copy-Labs/radix-native-ui/issues"
  },
  "homepage": "https://github.com/Copy-Labs/radix-native-ui#readme"
}
